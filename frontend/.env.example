# Copy to frontend/.env.local (gitignored) for local dev. On Vercel, set these in the project's
# Environment Variables. Never commit real values.

# Anthropic API - server-side only (route handlers). Without it the app still works: advisories and
# interviews fall back to templates clearly labelled "template", and /check says it needs a key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Only for the optional CISE engine pages (/engine, /incidents, /alerts, /reports, /activity),
# which need the FastAPI backend. Leave both unset for the standalone Virtual KL demo.
API_BASE_URL=
NEXT_PUBLIC_ENGINE_ENABLED=false
