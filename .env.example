# Copy this to .env and fill in real values. Never commit .env.

# For local docker-compose Postgres:
DATABASE_URL=postgresql+asyncpg://cise:cise@localhost:5432/cise

# For a hosted free-tier Postgres (Supabase/Neon), it looks like:
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>?ssl=require

POLL_INTERVAL_MINUTES_FAST=5
POLL_INTERVAL_MINUTES_SLOW=30

HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3

LOG_LEVEL=INFO

# Knowledge layer (only needed if running the app natively, not via Docker
# Compose - the compose file sets these to internal container addresses
# directly). These point at the host-mapped ports for local dev.
CHROMA_HOST=localhost
CHROMA_PORT=8001
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cisegraph123

# Intelligence layer - Anthropic API (Virtual KL, decision D-06). Server-side only.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# Optional. ACLED requires free registration at acleddata.com (unlike
# GDELT, which is open access). Leave blank to skip ACLED gracefully -
# the worker logs once and moves on, doesn't crash anything.
ACLED_API_KEY=
ACLED_EMAIL=

# Telegram alerts (optional - blank = alert delivery is skipped, nothing crashes).
# Setup steps are in the docstring at the top of app/alerts.py.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Lowest level that triggers a message: Red (default) or Orange.
ALERT_MIN_LEVEL=Red
# Optional: your public frontend URL, so alerts include an "open in CISE" link.
PUBLIC_APP_URL=

# Email alerts (optional - blank = skipped). For Gmail: turn on 2-Step
# Verification, create an App password at myaccount.google.com/apppasswords,
# and use that as SMTP_PASSWORD (your normal password will be rejected).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (port 587, default), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER.
SMTP_FROM=
# Who receives alerts. Several addresses: comma-separated.
ALERT_EMAIL_TO=

# News headlines for extra context (optional). Free key at https://gnews.io
# (100 requests/day, non-commercial use). Blank = the news worker is skipped.
GNEWS_API_KEY=
